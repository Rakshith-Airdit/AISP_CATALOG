<core:FragmentDefinition xmlns="sap.ui.comp.valuehelpdialog"
    xmlns:m="sap.m"
    xmlns:fb="sap.ui.comp.filterbar"
    xmlns:core="sap.ui.core">

    <ValueHelpDialog id="currencyValueHelp" title="Select Currency" afterClose=".onCurrencyVHAfterClose" supportMultiselect="false" key="WAERS" descriptionKey="LTEXT" ok=".onCurrencyVHOk" cancel=".onCurrencyVHCancel" contentWidth="800px" contentHeight="800px" verticalScrolling="false" horizontalScrolling="false">

        <filterBar>
            <fb:FilterBar useToolbar="false" advancedMode="false" search=".onCurrencyVHSearch" isRunningInValueHelpDialog="true" showFilterConfiguration="false" showRestoreButton="false" >
                <fb:filterGroupItems>
                    <fb:FilterGroupItem groupName="basic" name="search" label="Search Currency Code or Description" visibleInFilterBar="true">
                        <fb:control>
                            <m:Input value="{filters>/search}" placeholder="Enter Currency Code or Description" liveChange=".onCurrencyVHLiveChange"/>
                        </fb:control>
                    </fb:FilterGroupItem>
                </fb:filterGroupItems>
            </fb:FilterBar>
        </filterBar>

    </ValueHelpDialog>
</core:FragmentDefinition>