<core:FragmentDefinition xmlns="sap.ui.comp.valuehelpdialog"
    xmlns:m="sap.m"
    xmlns:fb="sap.ui.comp.filterbar"
    xmlns:core="sap.ui.core">

    <ValueHelpDialog id="uomValueHelp" title="Select Unit of Measure" ok=".onUomVHOk" cancel=".onUomVHCancel" supportMultiselect="false" key="UnitCode" descriptionKey="Text">

        <filterBar>
            <fb:FilterBar useToolbar="false" advancedMode="false" search=".onUomVHSearch" isRunningInValueHelpDialog="true" showFilterConfiguration="false" showRestoreButton="false" showClearButton="true">

                <fb:filterGroupItems>
                    <fb:FilterGroupItem groupName="basic" name="UnitCode" label="Unit Code" visibleInFilterBar="true">
                        <fb:control>
                            <m:Input value="{/filters/UnitCode}" placeholder="Enter Unit Code" />
                        </fb:control>
                    </fb:FilterGroupItem>

                    <fb:FilterGroupItem groupName="basic" name="Text" label="Description" visibleInFilterBar="true">
                        <fb:control>
                            <m:Input value="{/filters/Text}" placeholder="Enter Unit Description" />
                        </fb:control>
                    </fb:FilterGroupItem>
                </fb:filterGroupItems>
            </fb:FilterBar>
        </filterBar>

    </ValueHelpDialog>
</core:FragmentDefinition>