<core:FragmentDefinition xmlns="sap.ui.comp.valuehelpdialog"
    xmlns:m="sap.m"
    xmlns:fb="sap.ui.comp.filterbar"
    xmlns:core="sap.ui.core">

    <ValueHelpDialog id="uomValueHelp" title="Select Unit of Measure" afterClose=".onUomVHAfterClose" supportMultiselect="false" key="UnitCode" descriptionKey="Text" ok=".onUomVHOk" cancel=".onUomVHCancel" contentWidth="800px" contentHeight="800px" verticalScrolling="false" horizontalScrolling="false">

        <filterBar>
            <fb:FilterBar useToolbar="false" advancedMode="false" search=".onUomVHSearch" isRunningInValueHelpDialog="true" showFilterConfiguration="false" showRestoreButton="false">
                <fb:filterGroupItems>
                    <fb:FilterGroupItem groupName="basic" name="search" label="Search Unit Code or Description" visibleInFilterBar="true">
                        <fb:control>
                            <m:Input value="{filters>/search}" placeholder="Enter Unit Code or Description" liveChange=".onUomVHLiveChange"/>
                        </fb:control>
                    </fb:FilterGroupItem>
                </fb:filterGroupItems>
            </fb:FilterBar>
        </filterBar>

    </ValueHelpDialog>
</core:FragmentDefinition>