                <Property Name="ProductName" Type="Edm.String" sap:Label="Product Name" sap:quickinfo="Name of the product"/>
                <Property Name="ProductDescription" Type="Edm.String" sap:Label="Product Description" sap:quickinfo="Description of the product"/>
